# Copy to .env and adjust before running locally

PORT=3000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgres://eddash:eddash@localhost:5432/eddash
DATABASE_SSL=false

# Session secret - generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account (created automatically on startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set true to load demo patients/wards on startup when the patients table is empty
SEED_DEMO=false

# Set true when running behind nginx / a load balancer (enables secure cookies)
TRUST_PROXY=false

# ---- Three-server layout (npm run dev:all) --------------------------------
# Dashboard port (also used by the legacy single-process app)
PORT=3000

# Management API server: database, admin panel, integration API
API_PORT=4000

# PMS simulator: owns the pms.* schema and serves /api/patients + /api/wards
PMS_PORT=5000
PMS_SCHEMA=pms
PMS_SEED_DEMO=true

# Token the PMS simulator requires on its /api/* endpoints
PMS_SERVER_TOKEN=pms-local-token

# Outbound token the API sends when pulling from that PMS. Must match
# PMS_SERVER_TOKEN. When set it overrides the key saved in Admin > PMS integration.
PMS_API_KEY=pms-local-token

# How the dashboard reaches the API, and how pms:connect reaches the PMS
API_BASE_URL=http://127.0.0.1:4000
DASHBOARD_BASE_URL=http://127.0.0.1:3000
PMS_BASE_URL=http://127.0.0.1:5000/api
API_TIMEOUT_MS=4000

# Container/system timezone used for timestamps in logs
TZ=Asia/Kuala_Lumpur


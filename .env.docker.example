# Docker Compose settings for Ubuntu deployment.
# Copy to .env on the server, then edit every value marked CHANGE ME.

APP_PORT=3000
TZ=Asia/Kuala_Lumpur

POSTGRES_DB=eddash
POSTGRES_USER=eddash
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE-ME-long-random-string

# First admin account, created only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-strong-admin-password

# true loads demo patients when the patients table is empty. Keep false in production.
SEED_DEMO=false

# Set true when serving through nginx / a TLS-terminating proxy.
TRUST_PROXY=false

# Optional: outbound API key for pulling data from a patient management system.
# When set, this overrides the key saved in Admin > PMS integration.
PMS_API_KEY=

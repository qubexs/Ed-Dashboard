# Example reverse proxy for Ubuntu + nginx.
# 1. Replace dash.example.com with your hostname.
# 2. Install the file at /etc/nginx/sites-available/eddash and symlink into sites-enabled.
# 3. Run: sudo nginx -t && sudo systemctl reload nginx
# 4. Add TLS with: sudo certbot --nginx -d dash.example.com
# 5. Set TRUST_PROXY=true in the app .env when TLS is enabled.

server {
    listen 80;
    listen [::]:80;
    server_name dash.example.com;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

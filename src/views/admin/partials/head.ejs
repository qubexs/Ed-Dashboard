<%
  const nav = [
    { key: "overview", href: "/admin", label: "Overview" },
    { key: "patients", href: "/admin/patients", label: "Patients" },
    { key: "wards", href: "/admin/wards", label: "Ward admissions" },
    { key: "integration", href: "/admin/integration", label: "PMS integration" },
    { key: "zones", href: "/admin/zones", label: "Zones" },
    { key: "settings", href: "/admin/settings", label: "Display settings" },
    { key: "users", href: "/admin/users", label: "Users" },
    { key: "api-keys", href: "/admin/api-keys", label: "API keys" },
    { key: "health", href: "/admin/health", label: "Health" }
  ];
  const titles = {
    overview: "Overview",
    patients: "Patients",
    wards: "Ward admissions",
    integration: "PMS integration",
    zones: "Triage zones",
    settings: "Display settings",
    users: "Users",
    "api-keys": "API keys",
    health: "System health"
  };
  const title = titles[page] || "Admin";
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %> — EDDASH Admin</title>
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <a class="brand" href="/admin">
          <img src="/img/logo.svg" alt="Logo" />
          <span class="brand-text">
            <strong>EDDASH</strong>
            <small>Emergency display</small>
          </span>
        </a>

        <nav class="nav">
          <% nav.forEach(function (item) { %>
          <a
            class="nav-link <%= page === item.key ? 'active' : '' %>"
            href="<%= item.href %>"
          ><%= item.label %></a>
          <% }); %>
        </nav>

        <div class="sidebar-bottom">
          <a class="btn btn-ghost btn-block" href="/" target="_blank" rel="noopener">
            Open live display
          </a>
          <div class="user-chip">
            <span class="avatar"><%= currentUser.username.slice(0, 1).toUpperCase() %></span>
            <span class="user-meta">
              <strong><%= currentUser.username %></strong>
              <small><%= currentUser.role %></small>
            </span>
          </div>
          <form method="post" action="/admin/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="link-button">Sign out</button>
          </form>
        </div>
      </aside>

      <main class="content">
        <header class="page-head">
          <div>
            <p class="kicker">Emergency Department</p>
            <h1><%= title %></h1>
          </div>
          <div class="head-actions">
            <a class="btn btn-ghost" href="/admin/health">System health</a>
            <a class="btn btn-primary" href="/admin/patients/new">Add patient</a>
          </div>
        </header>

        <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div>
        <% } %>

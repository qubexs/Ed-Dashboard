<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="10" />
    <title>Emergency Dashboard — connecting</title>
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: grid;
        place-items: center;
        background: radial-gradient(circle at 30% 20%, #16234a, #070b16 70%);
        color: #e8eefc;
        font-family: "Inter", "Segoe UI", system-ui, sans-serif;
        text-align: center;
      }
      .card {
        padding: 48px 64px;
        border: 1px solid rgba(120, 160, 255, 0.25);
        border-radius: 24px;
        background: rgba(10, 18, 38, 0.72);
      }
      .dot {
        display: inline-block;
        width: 14px;
        height: 14px;
        margin-right: 10px;
        border-radius: 50%;
        background: #f5a524;
        animation: pulse 1.6s ease-in-out infinite;
      }
      h1 {
        margin: 0 0 12px;
        font-size: 28px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      p {
        margin: 6px 0;
        color: #9fb0d0;
        font-size: 18px;
      }
      @keyframes pulse {
        50% {
          opacity: 0.25;
        }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1><span class="dot"></span>Reconnecting</h1>
      <p>The live feed is unavailable.</p>
      <p>This page retries every 10 seconds.</p>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= status %> — Emergency Dashboard</title>
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body class="auth-body">
    <main class="auth-card">
      <div class="auth-brand">
        <img src="/img/logo.svg" alt="Logo" />
        <div>
          <strong>EDDASH</strong>
          <small>Emergency department dashboard</small>
        </div>
      </div>

      <p class="error-code"><%= status %></p>
      <h1><%= status === 404 ? 'Page not found' : 'Something went wrong' %></h1>
      <p class="muted"><%= message %></p>

      <div class="auth-actions">
        <a class="btn btn-primary" href="/admin">Back to admin</a>
        <a class="btn btn-ghost" href="/">Live display</a>
      </div>
    </main>
  </body>
</html>
